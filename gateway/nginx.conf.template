limit_req_zone $binary_remote_addr zone=vassago_auth:10m rate=20r/m;

server {
    listen 443 ssl;
    server_name api.${BASE_DOMAIN};

    # server.crt is self-signed for DNS:localhost only. If BASE_DOMAIN is set to
    # anything else, reissue this cert with a SAN matching api.${BASE_DOMAIN} or
    # browsers/clients will reject the TLS handshake.
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    # Unauthenticated endpoints (login/recover/refresh/public-key) are the ones
    # credential-stuffing/enumeration abuse would target, so they get the coarse
    # per-IP limit here. Tighter per-account limiting lives in vassago itself.
    location /auth/ {
        limit_req zone=vassago_auth burst=5 nodelay;
        proxy_pass http://vassago:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Exact match so only the public /user/verify endpoint is throttled here —
    # the rest of /user is authenticated and shouldn't share this IP-based limit.
    location = /user/verify {
        limit_req zone=vassago_auth burst=5 nodelay;
        proxy_pass http://vassago:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /user {
        proxy_pass http://vassago:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /products {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /locations {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /stock/ {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /metadata {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /orgs {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /onboarding {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /credentials {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /services {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

server {
    listen 443 ssl;
    server_name grafana.${BASE_DOMAIN};

    # Uses the same cert as the api.${BASE_DOMAIN} block. Its current SAN list
    # (DNS:localhost, DNS:api.localhost, 127.0.0.1, ::1) does not include
    # grafana.${BASE_DOMAIN} — reissue with that SAN added before this is reachable
    # over TLS without a browser warning.
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    location / {
        proxy_pass http://grafana:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Grafana's live/websocket features (e.g. dashboard live updates) need the
        # Upgrade/Connection headers forwarded, or they silently fall back to polling.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name api.${BASE_DOMAIN} grafana.${BASE_DOMAIN};
    return 301 https://$host$request_uri;
}
