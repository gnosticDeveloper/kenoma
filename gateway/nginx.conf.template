server {
    listen 443 ssl;
    server_name api.${BASE_DOMAIN};

    # server.crt is self-signed for DNS:localhost only. If BASE_DOMAIN is set to
    # anything else, reissue this cert with a SAN matching api.${BASE_DOMAIN} or
    # browsers/clients will reject the TLS handshake.
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    location /auth/ {
        proxy_pass http://vassago:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /user {
        proxy_pass http://vassago:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /products {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /locations {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /stock/ {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /metadata {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /orgs {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /onboarding {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /credentials {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /services {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

server {
    listen 80;
    server_name api.${BASE_DOMAIN};
    return 301 https://$host$request_uri;
}
