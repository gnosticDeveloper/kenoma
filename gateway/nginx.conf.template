# CORS preflight (OPTIONS) requests are exempted from this limiter by mapping them to an
# empty key — nginx treats an empty limit_req key as "don't rate-limit this request". Without
# this, a rate-limited request gets a bare 503 with no CORS headers (nginx short-circuits
# before proxying to vassago, which is what actually sets Access-Control-Allow-Origin), so the
# browser reports it as a CORS policy violation instead of a 503 — and worse, every real login
# attempt burns two requests from the same budget (its own preflight plus the POST), so bursty
# but legitimate traffic (e.g. a page load's /auth/refresh followed by a login submit) can trip
# this and see a misleading, unrecoverable-looking "blocked by CORS policy" error.
map $request_method $vassago_auth_limit_key {
    OPTIONS "";
    default $binary_remote_addr;
}
limit_req_zone $vassago_auth_limit_key zone=vassago_auth:10m rate=20r/m;

server {
    listen 443 ssl;
    server_name api.${BASE_DOMAIN};

    # server.crt is self-signed for DNS:localhost only. If BASE_DOMAIN is set to
    # anything else, reissue this cert with a SAN matching api.${BASE_DOMAIN} or
    # browsers/clients will reject the TLS handshake.
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    # Unauthenticated endpoints (login/recover/refresh/public-key) are the ones
    # credential-stuffing/enumeration abuse would target, so they get the coarse
    # per-IP limit here. Tighter per-account limiting lives in vassago itself.
    location /auth/ {
        limit_req zone=vassago_auth burst=5 nodelay;
        proxy_pass http://vassago:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Exact match so only the public /user/verify endpoint is throttled here —
    # the rest of /user is authenticated and shouldn't share this IP-based limit.
    location = /user/verify {
        limit_req zone=vassago_auth burst=5 nodelay;
        proxy_pass http://vassago:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /user {
        proxy_pass http://vassago:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /products {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /locations {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /stock/ {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /metadata {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /units {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Batch variant pricing (VariantPricingController) lives at a top-level /variants/pricing
    # path, not nested under /products like variant CRUD — without this block it 404s/405s at
    # the gateway even though the service itself handles it correctly.
    location /variants {
        proxy_pass http://bime:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /orgs {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /export-jobs {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /dr-backups {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /onboarding {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /credentials {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /services {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /pricing {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /migrations {
        proxy_pass http://raum:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Each service exposes its own role names at its internal /roles path; exact-match
    # here so the external /roles/{service} URL can be routed to the right upstream
    # without colliding with another service's own top-level path namespace.
    location = /roles/vassago {
        proxy_pass http://vassago:8081/roles;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /roles/bime {
        proxy_pass http://bime:8082/roles;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /roles/raum {
        proxy_pass http://raum:8080/roles;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

server {
    listen 443 ssl;
    server_name grafana.${BASE_DOMAIN};

    # Uses the same cert as the api.${BASE_DOMAIN} block. Its current SAN list
    # (DNS:localhost, DNS:api.localhost, 127.0.0.1, ::1) does not include
    # grafana.${BASE_DOMAIN} — reissue with that SAN added before this is reachable
    # over TLS without a browser warning.
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    location / {
        proxy_pass http://grafana:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Grafana's live/websocket features (e.g. dashboard live updates) need the
        # Upgrade/Connection headers forwarded, or they silently fall back to polling.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name api.${BASE_DOMAIN} grafana.${BASE_DOMAIN};
    return 301 https://$host$request_uri;
}
