# ─── Raum database ────────────────────────────────────────────────────────────
RAUM_DB_USER=postgres
RAUM_DB_PASSWORD=postgres

# ─── Bime database ────────────────────────────────────────────────────────────
BIME_DB_USER=postgres
BIME_DB_PASSWORD=postgres

# ─── Vassago database ─────────────────────────────────────────────────────────
VASSAGO_DB_USER=admin
VASSAGO_DB_PASSWORD=adminpass


# ─── Init mode ─────────────────────────────────────────────────────────────────
# seeded (default) — seeds the platform operator account below and registers
#   Vassago/Bime db credentials + connections in OpenBao, fully ready to use.
# clean — skips OpenBao db credential/connection registration for Vassago/Bime
#   and only seeds an admin user if the vassago users table is empty, leaving
#   the rest for manual configuration.
KENOMA_INIT_MODE=seeded

# ─── Platform operator account ────────────────────────────────────────────────
OPERATOR_NAME=Platform
OPERATOR_LAST_NAME=Operator
OPERATOR_EMAIL=operator@internal
OPERATOR_USERNAME=platform_operator
OPERATOR_PASSWORD=Ch4ng3me!Ops#

# ─── Seed user (docker compose --profile seed) ────────────────────────────────
SEED_USER_NAME=Admin
SEED_USER_LAST_NAME=User
SEED_USER_EMAIL=admin@example.com
SEED_USER_USERNAME=admin
SEED_USER_PASSWORD=Ch4ng3me!Dev#

# ─── Mailgun (required for password recovery emails) ──────────────────────────
# Obtain from https://app.mailgun.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional — defaults to noreply@<MAILGUN_DOMAIN>
MAILGUN_FROM=

# ─── Application ──────────────────────────────────────────────────────────────
# Base URL of your frontend, used to construct verification links in emails
APP_BASE_URL=http://localhost:3000

# ─── Subdomain support (issue #85) ─────────────────────────────────────────────
# Root domain for the deployment. The API is served at api.<BASE_DOMAIN> via nginx.
# e.g. BASE_DOMAIN=kenoma.dev -> API reachable at https://api.kenoma.dev
BASE_DOMAIN=localhost
# Domain attribute for the refresh-token cookie so it's shared across subdomains
# of BASE_DOMAIN, e.g. .kenoma.dev — leave blank for a host-only cookie (default,
# fine for single-origin/local dev)
VASSAGO_COOKIE_DOMAIN=
# Comma-separated list of allowed CORS origin patterns for credentialed
# cross-subdomain requests, e.g. https://*.kenoma.dev — leave blank to disable CORS.
# Shared by vassago, raum, and bime — all three sit behind the same api.<BASE_DOMAIN>
# origin and are called directly by the frontend, so all three need the same allow-list.
CORS_ALLOWED_ORIGINS=

# ─── Grafana ────────────────────────────────────────────────────────────────
# Grafana is reachable at https://grafana.<BASE_DOMAIN> via nginx, so these
# credentials are internet-facing — required (compose fails to start without
# them) rather than defaulting to admin/admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Ch4ng3me!Grafana#

# ─── Remote debugging (development only — leave unset in production) ─────────
# Enables a JDWP remote-debug listener inside the raum/vassago/bime containers
# (still bound to 127.0.0.1 on the host via the port mapping in docker-compose.yml).
# Leave these unset/empty in production — that's the default, debugging is off
# unless you explicitly opt in below.
# RAUM_JDWP_OPTS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
# VASSAGO_JDWP_OPTS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5006
# BIME_JDWP_OPTS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5007
