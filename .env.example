# Mailgun — required for email verification on user creation
# Obtain from https://app.mailgun.com

# Your Mailgun Private API key (starts with "key-")
MAILGUN_API_KEY=

# The sending domain registered and verified in Mailgun
MAILGUN_DOMAIN=

# The From address on verification emails (optional — defaults to noreply@<MAILGUN_DOMAIN>)
MAILGUN_FROM=

# Base URL of the frontend/client app, used to construct the verification link in emails
# The link will be: <APP_BASE_URL>/verify?orgId=<uuid>&token=<token>
APP_BASE_URL=http://localhost:3000
